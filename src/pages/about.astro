---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { aboutContent } from '../i18n/pages';
import { siteConfig } from '../config/site';
import { publicAsset } from '../utils/asset';
const locales = ['zh', 'en'] as const;
type ImageModule = { default: ImageMetadata };
const sortedAssets = (modules: Record<string, ImageModule>) => Object.entries(modules)
  .map(([path, module]) => ({ name: path.split('/').pop() ?? path, image: module.default }))
  .sort((a, b) => a.name.localeCompare(b.name, 'en', { numeric: true }));
const studioImages = sortedAssets(import.meta.glob<ImageModule>('../assets/studio/*.{avif,jpeg,jpg,png,webp,AVIF,JPEG,JPG,PNG,WEBP}', { eager: true }));
const workImages = sortedAssets(import.meta.glob<ImageModule>('../assets/about/work/*.{avif,jpeg,jpg,png,webp,AVIF,JPEG,JPG,PNG,WEBP}', { eager: true }));
const certificateSources = sortedAssets(import.meta.glob<ImageModule>('../assets/about/certificates/*.{avif,jpeg,jpg,png,webp,AVIF,JPEG,JPG,PNG,WEBP}', { eager: true }));
const certificateImages = await Promise.all(certificateSources.map(async (item) => ({ ...item, fullSrc: (await getImage({ src: item.image, width: 2400, format: 'webp', quality: 82 })).src })));
const visitCopy = {
  zh: {
    eyebrow: 'THE STUDIO', title: '一個安靜、清楚，也尊重界線的空間。',
    body: '工作室以隱私、整潔與自在為基本考量，讓諮詢與照護都能在不被催促的節奏裡進行。',
    gallery: '環境照片', empty: '工作室環境照片整理中。', visit: 'VISIT US', address: '地址', transport: '交通資訊',
    transportBody: '詳細抵達方式、停車與大眾運輸資訊，將於預約確認時提供。', map: 'Mikami Studio Google 地圖', mapLink: '在 Google Maps 開啟',
  },
  en: {
    eyebrow: 'THE STUDIO', title: 'A quiet space, with clarity and boundaries in mind.',
    body: 'Privacy, cleanliness, and ease shape the studio environment, leaving room for consultation and care without pressure.',
    gallery: 'Studio photographs', empty: 'Studio photographs are being prepared.', visit: 'VISIT US', address: 'Address', transport: 'Getting here',
    transportBody: 'Detailed arrival, parking, and public transport guidance is provided when an appointment is confirmed.', map: 'Mikami Studio on Google Maps', mapLink: 'Open in Google Maps',
  },
} as const;
const storyCopy = {
  zh: {
    workEyebrow: 'AT WORK', workTitle: '專業，藏在每一次準備與專注裡。',
    workBody: '從事前準備、操作細節到完成後的照護說明，每一步都以清楚、衛生與尊重為前提。', workGallery: 'Mikami Studio 工作紀錄',
    credentialsEyebrow: 'PROFESSIONAL RECORDS', credentialsTitle: '持續學習，是專業照護的一部分。',
    credentialsBody: '證書與培訓紀錄呈現工作室持續精進技術的歷程。點擊影像可查看完整內容。', credentialsGallery: '專業證書與培訓紀錄',
    openImage: '放大查看', closeImage: '關閉圖片',
  },
  en: {
    workEyebrow: 'AT WORK', workTitle: 'Professional care lives in preparation and attention.',
    workBody: 'From preparation and considered technique to aftercare guidance, each step is grounded in clarity, hygiene, and respect.', workGallery: 'Mikami Studio at work',
    credentialsEyebrow: 'PROFESSIONAL RECORDS', credentialsTitle: 'Continual learning is part of caring well.',
    credentialsBody: 'Certificates and training records reflect an ongoing commitment to professional technique. Select an image to view it in full.', credentialsGallery: 'Certificates and training records',
    openImage: 'View image', closeImage: 'Close image',
  },
} as const;
const mapQuery = encodeURIComponent(siteConfig.address);
const mapEmbedUrl = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const mapLinkUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---
<BaseLayout localizedMeta={{ zh: aboutContent.zh.meta, en: aboutContent.en.meta }}>
  {locales.map((locale) => {
    const copy = aboutContent[locale];
    return (
      <article class="about-page" data-copy={locale} lang={locale === 'en' ? 'en' : undefined}>
        <header class="editorial-hero page-shell">
          <div class="editorial-hero__copy" data-reveal="hero-copy">
            <p class="eyebrow">{copy.eyebrow}</p>
            <h1>{copy.title}</h1>
            <p class="editorial-lead">{copy.lead}</p>
          </div>
          <figure class="editorial-hero__image" data-reveal="hero-image"><img src={publicAsset('images/home/hero-campaign.jpg')} width="1200" height="1200" alt={copy.alts.hero} data-parallax /></figure>
        </header>

        <section class="about-manifesto page-shell">
          <div class="about-manifesto__copy">
            <p class="eyebrow">{copy.philosophy.eyebrow}</p>
            <h2>{copy.philosophy.title}</h2>
            {copy.philosophy.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <figure><img src={publicAsset('images/shared/serum-hands.jpg')} width="1800" height="1200" loading="lazy" alt={copy.alts.detail} /></figure>
        </section>

        <section class="about-values page-shell" aria-label={copy.philosophy.eyebrow}>
          {copy.values.map((value) => <article><span>{value.number}</span><h2>{value.title}</h2><p>{value.body}</p></article>)}
        </section>

        <section class="about-experience">
          <figure><img src={publicAsset('images/shared/skincare-products.jpg')} width="1800" height="1200" loading="lazy" alt={copy.alts.still} /></figure>
          <div class="about-experience__copy">
            <p class="eyebrow">{copy.experience.eyebrow}</p><h2>{copy.experience.title}</h2>
            {copy.experience.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="work-story page-shell" aria-labelledby={`work-title-${locale}`}>
          <div class="work-story__heading">
            <p class="eyebrow">{storyCopy[locale].workEyebrow}</p>
            <h2 id={`work-title-${locale}`}>{storyCopy[locale].workTitle}</h2>
            <p>{storyCopy[locale].workBody}</p>
          </div>
          <div class="work-story__gallery" aria-label={storyCopy[locale].workGallery}>
            {workImages.map((item, index) => (
              <figure><Image src={item.image} widths={[480, 768, 1200]} sizes="(min-width: 768px) 58vw, 100vw" layout="constrained" format="webp" quality={76} loading="lazy" decoding="async" alt={`${storyCopy[locale].workGallery} ${index + 1}`} /></figure>
            ))}
          </div>
        </section>

        <section class="credentials-story" aria-labelledby={`credentials-title-${locale}`}>
          <div class="credentials-story__inner page-shell">
            <div class="credentials-story__heading">
              <p class="eyebrow">{storyCopy[locale].credentialsEyebrow}</p>
              <h2 id={`credentials-title-${locale}`}>{storyCopy[locale].credentialsTitle}</h2>
              <p>{storyCopy[locale].credentialsBody}</p>
            </div>
            <div class="credentials-story__gallery" aria-label={storyCopy[locale].credentialsGallery}>
              {certificateImages.map((item, index) => {
                const src = item.fullSrc;
                const alt = `${storyCopy[locale].credentialsGallery} ${index + 1}`;
                return (
                  <figure>
                    <button type="button" data-about-image-open data-src={src} data-alt={alt} aria-label={`${storyCopy[locale].openImage} ${index + 1}`}>
                      <Image src={item.image} widths={[480, 768, 1100]} sizes="(min-width: 768px) 34vw, 100vw" layout="constrained" format="webp" quality={78} loading="lazy" decoding="async" alt={alt} />
                    </button>
                    <figcaption>{String(index + 1).padStart(2, '0')} / MIKAMI STUDIO</figcaption>
                  </figure>
                );
              })}
            </div>
          </div>
        </section>

        <section class="studio-introduction page-shell" aria-labelledby={`studio-title-${locale}`}>
          <div class="studio-introduction__copy">
            <p class="eyebrow">{visitCopy[locale].eyebrow}</p>
            <h2 id={`studio-title-${locale}`}>{visitCopy[locale].title}</h2>
            <p>{visitCopy[locale].body}</p>
          </div>
          <div class="studio-gallery" aria-label={visitCopy[locale].gallery}>
            {studioImages.length ? studioImages.map((item, index) => (
              <figure><Image src={item.image} widths={[480, 768, 1200]} sizes="(min-width: 768px) 58vw, 100vw" layout="constrained" format="webp" quality={76} loading="lazy" decoding="async" alt={`${visitCopy[locale].gallery} ${index + 1}`} /></figure>
            )) : <p class="studio-gallery__empty">{visitCopy[locale].empty}</p>}
          </div>
        </section>

        <section class="visit-us" aria-labelledby={`visit-title-${locale}`}>
          <div class="visit-us__inner page-shell">
            <div class="visit-us__copy">
              <p class="eyebrow">{visitCopy[locale].visit}</p>
              <h2 id={`visit-title-${locale}`}>{siteConfig.brandName}</h2>
              <dl>
                <div><dt>{visitCopy[locale].address}</dt><dd><address>{siteConfig.address}</address></dd></div>
                <div><dt>{visitCopy[locale].transport}</dt><dd>{visitCopy[locale].transportBody}</dd></div>
              </dl>
              <a class="text-link" href={mapLinkUrl} target="_blank" rel="noreferrer">{visitCopy[locale].mapLink}<span aria-hidden="true">↗</span></a>
            </div>
            <div class="visit-us__map">
              <iframe src={mapEmbedUrl} title={visitCopy[locale].map} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          </div>
        </section>

        <section class="editorial-closing page-shell">
          <p class="eyebrow">{copy.closing.eyebrow}</p><h2>{copy.closing.title}</h2><p>{copy.closing.body}</p>
          <a class="primary-link" href={siteConfig.lineUrl}>{copy.closing.action}<span aria-hidden="true">→</span></a>
        </section>
      </article>
    );
  })}

  <dialog class="media-lightbox" data-about-image-dialog aria-label={storyCopy.zh.closeImage} data-aria-zh={storyCopy.zh.closeImage} data-aria-en={storyCopy.en.closeImage}>
    <div class="media-lightbox__surface">
      <button type="button" class="media-lightbox__close" data-about-image-close><span data-copy="zh">關閉</span><span data-copy="en">Close</span></button>
      <img data-about-image src="" alt="" />
    </div>
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('[data-about-image-dialog]');
    const image = dialog?.querySelector<HTMLImageElement>('[data-about-image]');
    document.querySelectorAll<HTMLButtonElement>('[data-about-image-open]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog || !image) return;
        image.src = button.dataset.src ?? '';
        image.alt = button.dataset.alt ?? '';
        dialog.showModal();
      });
    });
    dialog?.querySelector('[data-about-image-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog?.addEventListener('close', () => { if (image) { image.src = ''; image.alt = ''; } });
  </script>
</BaseLayout>
