---
import { content } from '../i18n/content';
import { siteConfig } from '../config/site';
import { publicAsset } from '../utils/asset';

const heroImage = publicAsset('images/home/hero-campaign.jpg');
const concepts = [
  { id: 'quiet', number: '01', name: 'Quiet Luxury Editorial' },
  { id: 'romantic', number: '02', name: 'Neo Romantic' },
  { id: 'dusty-atelier', number: '03', name: 'Dusty Rose Atelier' },
  { id: 'tea-rose', number: '04', name: 'Tea Rose Minimal' },
  { id: 'blush-collage', number: '05', name: 'Blush Paper Collage' },
  { id: 'quiet-rose', number: '06', name: 'Quiet Rose Editorial' },
  { id: 'romantic-atelier', number: '07', name: 'Muted Romantic Atelier' },
  { id: 'tea-luxury', number: '08', name: 'Tea Rose Luxury' },
  { id: 'dusty-paper', number: '09', name: 'Dusty Paper Editorial' },
  { id: 'romantic-minimal', number: '10', name: 'Romantic Minimal' },
  { id: 'blush-atelier', number: '11', name: 'Blush Atelier' },
  { id: 'veiled-peony', number: '12', name: 'Veiled Peony' },
  { id: 'french-journal', number: '13', name: 'French Rose Journal' },
  { id: 'powder-mono', number: '14', name: 'Powder Monochrome' },
  { id: 'midnight-rose', number: '15', name: 'Midnight Rose' },
  { id: 'love-letter', number: '16', name: 'Antique Love Letter' },
] as const;

const localeScript = `(() => {
  const locale = new URLSearchParams(location.search).get('lang') === 'en' ? 'en' : 'zh';
  document.documentElement.dataset.locale = locale;
  document.documentElement.lang = locale === 'en' ? 'en' : 'zh-Hant-TW';
  document.title = locale === 'en' ? 'Style Lab | Mikami Studio' : '視覺風格實驗室｜Mikami Studio';
  document.querySelectorAll('[data-language-link]').forEach((link) => {
    const url = new URL(location.href);
    const next = link.getAttribute('data-language-link');
    url.searchParams.set('lang', next);
    link.setAttribute('href', url.pathname + url.search + url.hash);
    if (next === locale) link.setAttribute('aria-current', 'true');
  });
  document.querySelectorAll('[data-hero-image]').forEach((image) => {
    image.setAttribute('alt', image.getAttribute(locale === 'en' ? 'data-alt-en' : 'data-alt-zh'));
  });
})();`;
---

<!doctype html>
<html lang="zh-Hant-TW" data-locale="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Mikami Studio temporary hero art direction exploration." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Noto+Sans+TC:wght@300;400;500;600&family=Noto+Serif+TC:wght@400;500;600&display=swap" />
    <title>視覺風格實驗室｜Mikami Studio</title>
    <script is:inline set:html={localeScript}></script>
  </head>
  <body>
    <a class="skip-link" href="#concepts"><span data-copy="zh">跳至設計提案</span><span data-copy="en">Skip to concepts</span></a>

    <header class="lab-header">
      <div>
        <p>MIKAMI STUDIO / STYLE LAB</p>
        <span data-copy="zh">臨時視覺探索 · 不公開於網站導覽</span>
        <span data-copy="en">Temporary visual exploration · Not in site navigation</span>
      </div>
      <nav aria-label="Language">
        <a href="?lang=zh" data-language-link="zh">中文</a>
        <a href="?lang=en" data-language-link="en">EN</a>
      </nav>
    </header>

    <nav class="theme-nav" aria-label="Theme navigation">
      <span data-copy="zh">選擇主題</span><span data-copy="en">Browse themes</span>
      <div>
        {concepts.map((concept) => (
          <a href={`#${concept.id}`}><b>{concept.number}</b>{concept.name}</a>
        ))}
      </div>
    </nav>

    <main id="concepts">
      {concepts.map((concept) => (
        <section id={concept.id} class={`concept concept--${concept.id}`} aria-labelledby={`concept-${concept.id}`}>
          <header class="concept-label">
            <span>{concept.number}</span>
            <h2 id={`concept-${concept.id}`}>{concept.name}</h2>
          </header>

          <div class="hero">
            <div class="hero__copy">
              <p class="brand">MIKAMI STUDIO</p>
              <p class="eyebrow">
                <span data-copy="zh">{content.zh.home.hero.eyebrow}</span>
                <span data-copy="en">{content.en.home.hero.eyebrow}</span>
              </p>
              <h3>
                <span data-copy="zh">{content.zh.home.hero.title}</span>
                <span data-copy="en">{content.en.home.hero.title}</span>
              </h3>
              <p class="intro">
                <span data-copy="zh">{content.zh.home.hero.intro}</span>
                <span data-copy="en">{content.en.home.hero.intro}</span>
              </p>
              <a class="cta" href={siteConfig.lineUrl}>
                <span data-copy="zh">{content.zh.home.hero.book}</span>
                <span data-copy="en">{content.en.home.hero.book}</span>
                <i aria-hidden="true">→</i>
              </a>
            </div>
            <figure class="hero__image">
              <img
                src={heroImage}
                width="1200"
                height="1200"
                loading={concept.number === '01' ? 'eager' : 'lazy'}
                alt={content.zh.home.hero.imageAlt}
                data-hero-image
                data-alt-zh={content.zh.home.hero.imageAlt}
                data-alt-en={content.en.home.hero.imageAlt}
              />
            </figure>
            <span class="decoration" aria-hidden="true"></span>
          </div>
        </section>
      ))}
    </main>
  </body>
</html>

<style is:global>
  :root { color-scheme: light; font-family: "Noto Sans TC", sans-serif; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; background: #eeeae4; color: #201e1c; }
  img { max-width: 100%; }
  a { color: inherit; }
  [data-copy="en"] { display: none; }
  html[data-locale="en"] [data-copy="zh"] { display: none; }
  html[data-locale="en"] [data-copy="en"] { display: revert; }
  :focus-visible { outline: 3px solid #a84d35; outline-offset: 4px; }
  .skip-link { position: fixed; z-index: 20; top: .75rem; left: .75rem; padding: .75rem 1rem; background: #111; color: #fff; transform: translateY(-180%); }
  .skip-link:focus { transform: none; }
  .lab-header { min-height: 5.25rem; padding: 1rem clamp(1.25rem, 4vw, 4rem); display: flex; align-items: center; justify-content: space-between; gap: 1rem; background: #171614; color: #f8f4ed; }
  .lab-header p { margin: 0 0 .25rem; font: 600 .72rem/1.2 "Noto Sans TC", sans-serif; letter-spacing: .16em; }
  .lab-header span { color: #bdb6ac; font-size: .7rem; }
  .lab-header nav { display: flex; gap: .25rem; }
  .lab-header nav a { min-width: 3rem; min-height: 2.75rem; display: grid; place-items: center; font-size: .72rem; text-decoration: none; }
  .lab-header nav a[aria-current="true"] { text-decoration: underline; text-underline-offset: .4em; }
  .theme-nav { min-height: 4.5rem; padding-inline: clamp(1rem, 4vw, 4rem); display: flex; align-items: center; gap: 1.5rem; position: sticky; z-index: 10; top: 0; overflow: hidden; border-bottom: 1px solid #383633; background: rgb(23 22 20 / .96); color: #f8f4ed; }
  .theme-nav > span { flex: 0 0 auto; color: #bdb6ac; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; }
  .theme-nav > div { display: flex; flex: 1 1 auto; overflow-x: auto; scrollbar-width: thin; }
  .theme-nav a { min-height: 4.5rem; padding: 0 1rem; display: inline-flex; flex: 0 0 auto; align-items: center; gap: .55rem; border-inline-start: 1px solid #383633; color: #d8d2c9; font-size: .68rem; letter-spacing: .04em; text-decoration: none; white-space: nowrap; }
  .theme-nav a:hover { background: #2b2926; color: #fff; }
  .theme-nav b { color: #a9a197; font: 400 .64rem/1 monospace; }
  .concept { padding: clamp(3.5rem, 7vw, 7rem) clamp(1rem, 4vw, 4rem); scroll-margin-top: 4.5rem; }
  .concept-label { max-width: 88rem; margin: 0 auto 1rem; display: flex; align-items: baseline; gap: .75rem; color: #5a5650; }
  .concept-label span { font: 500 .7rem/1 monospace; }
  .concept-label h2 { margin: 0; font: 500 .72rem/1.2 "Noto Sans TC", sans-serif; letter-spacing: .13em; text-transform: uppercase; }
  .hero { max-width: 88rem; min-height: min(48rem, calc(100dvh - 8rem)); margin: auto; position: relative; overflow: hidden; }
  .hero__copy { position: relative; z-index: 2; }
  .brand, .eyebrow, .intro { margin: 0; }
  .hero h3 { margin: 0; font-weight: 500; }
  .hero__image { margin: 0; overflow: hidden; }
  .hero__image img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .cta { min-height: 3rem; width: fit-content; display: inline-flex; align-items: center; gap: 1rem; font-size: .78rem; text-decoration: none; }
  .cta i { font-style: normal; transition: transform 180ms ease; }
  .cta:hover i { transform: translateX(.3rem); }

  /* 01 — warm tonal restraint, fine rules, generous serif rhythm */
  .concept--quiet { background: #e9e0d6; }
  .concept--quiet .hero { padding: clamp(2rem, 5vw, 5rem); display: grid; align-items: center; background: #f7f2eb; }
  .concept--quiet .hero__copy { max-width: 48rem; padding: clamp(1rem, 4vw, 4rem) 0; }
  .concept--quiet .brand { margin-bottom: clamp(4rem, 10vw, 8rem); color: #4d4039; font: 600 clamp(.9rem, 1.3vw, 1.15rem)/1 "Cormorant Garamond", serif; letter-spacing: .3em; }
  .concept--quiet .eyebrow { color: #7b685e; font-size: .66rem; letter-spacing: .2em; }
  .concept--quiet h3 { max-width: 8ch; margin: 1.4rem 0 1.8rem; color: #352d29; font-family: "Noto Serif TC", serif; font-size: clamp(3.1rem, 7vw, 7rem); letter-spacing: -.055em; line-height: 1.13; }
  html[data-locale="en"] .concept--quiet h3 { font-family: "Cormorant Garamond", serif; line-height: .88; }
  .concept--quiet .intro { max-width: 31rem; color: #6f625b; font-size: 1rem; line-height: 1.85; }
  .concept--quiet .cta { margin-top: 2.5rem; border-bottom: 1px solid #5e4b42; color: #4d4039; letter-spacing: .08em; }
  .concept--quiet .hero__image { height: 22rem; }
  .concept--quiet .hero__image img { filter: sepia(.1) saturate(.72) contrast(.94); object-position: center 55%; }

  /* 02 — airy Japanese grid, restrained ink and persimmon detail */
  .concept--japanese { background: #f2f0e9; }
  .concept--japanese .hero { min-height: 48rem; padding: clamp(1.5rem, 4vw, 4rem); display: grid; grid-template-rows: auto 1fr; border: 1px solid #c9c7bc; background: #f8f7f2; }
  .concept--japanese .hero::before { content: "美 / 肌"; position: absolute; top: 1.6rem; right: clamp(1.5rem, 4vw, 4rem); color: #9d3b28; font: 500 .66rem/1 "Noto Serif TC", serif; letter-spacing: .35em; writing-mode: vertical-rl; }
  .concept--japanese .hero__copy { max-width: 47rem; align-self: center; padding: 4rem 0 3rem; }
  .concept--japanese .brand { color: #242522; font-size: .7rem; font-weight: 600; letter-spacing: .28em; }
  .concept--japanese .eyebrow { margin-top: 5rem; color: #77786f; font-size: .62rem; letter-spacing: .18em; }
  .concept--japanese h3 { max-width: 9ch; margin: 1.5rem 0 2rem; font-family: "Noto Serif TC", serif; font-size: clamp(2.8rem, 6.5vw, 6rem); font-weight: 400; letter-spacing: .04em; line-height: 1.35; }
  html[data-locale="en"] .concept--japanese h3 { max-width: 10ch; font-family: "Noto Sans TC", sans-serif; font-weight: 300; letter-spacing: -.04em; line-height: 1.02; }
  .concept--japanese .intro { max-width: 33rem; color: #65675f; line-height: 2.05; }
  .concept--japanese .cta { margin-top: 2.75rem; padding: .5rem 0; color: #8c3021; letter-spacing: .12em; }
  .concept--japanese .hero__image { min-height: 23rem; }
  .concept--japanese .hero__image img { filter: grayscale(.22) saturate(.72) brightness(1.06); object-position: center 57%; }

  /* 05 — Nordic utility, pale timber tones, compact grotesk typography */
  .concept--nordic { background: #d9ded8; }
  .concept--nordic .concept-label { color: #31423a; }
  .concept--nordic .hero { padding: clamp(1.5rem, 4vw, 4rem); display: grid; align-items: end; background: #f4f5ef; color: #26332d; }
  .concept--nordic .hero__copy { max-width: 42rem; padding-top: 3rem; }
  .concept--nordic .brand { font-size: .75rem; font-weight: 600; letter-spacing: .08em; }
  .concept--nordic .eyebrow { margin-top: clamp(4rem, 10vw, 9rem); color: #61726a; font-size: .65rem; letter-spacing: .14em; }
  .concept--nordic h3 { max-width: 11ch; margin: 1rem 0 1.5rem; font-family: "Noto Sans TC", sans-serif; font-size: clamp(2.8rem, 6vw, 5.8rem); font-weight: 400; letter-spacing: -.055em; line-height: 1.05; }
  .concept--nordic .intro { max-width: 34rem; color: #53615b; line-height: 1.75; }
  .concept--nordic .cta { margin-top: 2rem; padding: .8rem 1rem; border: 1px solid #496057; }
  .concept--nordic .hero__image { min-height: 24rem; margin-top: 3rem; }
  .concept--nordic .hero__image img { filter: grayscale(.35) sepia(.08) saturate(.55) brightness(1.08); object-position: center 58%; }

  /* 06 — saturated rose field, delicate oversized serif, floating portrait */
  .concept--romantic { background: #f4ced8; }
  .concept--romantic .concept-label { color: #7d2946; }
  .concept--romantic .hero { min-height: 50rem; padding: clamp(2rem, 5vw, 5rem); background: #b65a7a; color: #fff8f6; }
  .concept--romantic .hero__copy { min-height: 44rem; display: flex; flex-direction: column; align-items: flex-start; }
  .concept--romantic .brand { font: 500 1rem/1 "Cormorant Garamond", serif; letter-spacing: .25em; }
  .concept--romantic .eyebrow { margin-top: auto; font-size: .65rem; letter-spacing: .18em; }
  .concept--romantic h3 { max-width: 8ch; margin: 1rem 0 1.5rem; font-family: "Noto Serif TC", serif; font-size: clamp(3.6rem, 8vw, 8rem); font-weight: 400; letter-spacing: -.05em; line-height: 1.04; }
  html[data-locale="en"] .concept--romantic h3 { font-family: "Cormorant Garamond", serif; line-height: .8; }
  .concept--romantic .intro { max-width: 29rem; color: #ffe7ed; line-height: 1.7; }
  .concept--romantic .cta { margin-top: 2rem; padding: .75rem 1.1rem; background: #fff2f4; color: #6b223a; }
  .concept--romantic .hero__image { width: min(40vw, 30rem); height: 68%; position: absolute; right: 4%; top: 8%; transform: rotate(3deg); box-shadow: 1.25rem 1.25rem 0 #8f3d5a; }
  .concept--romantic .hero__image img { filter: sepia(.08) saturate(.9) contrast(.92); object-position: center 55%; }

  /* 08 — primary geometry, hard grid, high-energy modernist typography */
  .concept--bauhaus { background: #f0d33f; }
  .concept--bauhaus .concept-label { color: #171717; }
  .concept--bauhaus .hero { min-height: 48rem; display: grid; border: 3px solid #151515; background: #f5e7d0; color: #151515; }
  .concept--bauhaus .hero__copy { padding: clamp(2rem, 5vw, 5rem); }
  .concept--bauhaus .brand { font-size: .78rem; font-weight: 600; letter-spacing: .04em; }
  .concept--bauhaus .eyebrow { margin-top: 4rem; font-size: .65rem; font-weight: 600; }
  .concept--bauhaus h3 { max-width: 8ch; margin: 1rem 0 1.5rem; font-family: "Noto Sans TC", sans-serif; font-size: clamp(3.6rem, 8vw, 7.5rem); font-weight: 600; letter-spacing: -.09em; line-height: .9; }
  .concept--bauhaus .intro { max-width: 31rem; line-height: 1.6; }
  .concept--bauhaus .cta { margin-top: 2rem; padding: .8rem 1.1rem; background: #164b9c; color: #fff; }
  .concept--bauhaus .hero__image { min-height: 28rem; border-top: 3px solid #151515; }
  .concept--bauhaus .hero__image img { filter: grayscale(1) contrast(1.35); mix-blend-mode: multiply; object-position: center 56%; }
  .concept--bauhaus .decoration { width: 8rem; height: 8rem; position: absolute; z-index: 3; right: -2rem; top: -2rem; border-radius: 50%; background: #d83b2d; }

  /* 09 — earthen calm, soft crop, grounded serif and tactile border */
  .concept--organic { background: #9eaa91; }
  .concept--organic .concept-label { color: #263224; }
  .concept--organic .hero { min-height: 49rem; padding: clamp(2rem, 5vw, 5rem); display: grid; background: #d8cbb6; color: #293326; }
  .concept--organic .hero__copy { align-self: center; }
  .concept--organic .brand { font: 600 .75rem/1 "Cormorant Garamond", serif; letter-spacing: .22em; }
  .concept--organic .eyebrow { margin-top: clamp(3rem, 8vw, 7rem); color: #57614d; font-size: .65rem; letter-spacing: .16em; }
  .concept--organic h3 { max-width: 9ch; margin: 1.25rem 0 1.75rem; font-family: "Noto Serif TC", serif; font-size: clamp(3.1rem, 6.5vw, 6.2rem); font-weight: 400; letter-spacing: -.035em; line-height: 1.18; }
  html[data-locale="en"] .concept--organic h3 { font-family: "Cormorant Garamond", serif; line-height: .9; }
  .concept--organic .intro { max-width: 32rem; color: #4e5848; line-height: 1.85; }
  .concept--organic .cta { margin-top: 2.25rem; padding: .7rem 0; border-bottom: 1px solid #43513d; }
  .concept--organic .hero__image { min-height: 25rem; border: .65rem solid #ebe3d4; }
  .concept--organic .hero__image img { filter: sepia(.25) saturate(.55) hue-rotate(345deg); object-position: center 57%; }

  /* 11 — black, champagne and symmetrical deco framing */
  .concept--deco { background: #b49a69; }
  .concept--deco .concept-label { color: #342817; }
  .concept--deco .hero { min-height: 52rem; padding: clamp(2rem, 5vw, 5rem); background: #151310; color: #ead8b2; text-align: center; }
  .concept--deco .hero::before { content: ""; position: absolute; inset: 1.25rem; border: 1px solid #9e8356; pointer-events: none; }
  .concept--deco .hero__copy { min-height: 45rem; display: flex; flex-direction: column; align-items: center; }
  .concept--deco .brand { font: 500 1.1rem/1 "Cormorant Garamond", serif; letter-spacing: .32em; }
  .concept--deco .eyebrow { margin-top: auto; color: #c8ad7c; font-size: .62rem; letter-spacing: .25em; }
  .concept--deco h3 { max-width: 9ch; margin: 1.1rem auto 1.5rem; font-family: "Noto Serif TC", serif; font-size: clamp(3rem, 7vw, 6.5rem); font-weight: 400; line-height: 1.15; }
  html[data-locale="en"] .concept--deco h3 { font-family: "Cormorant Garamond", serif; line-height: .86; }
  .concept--deco .intro { max-width: 31rem; color: #c9bfae; line-height: 1.75; }
  .concept--deco .cta { margin-top: 2rem; padding: .75rem 1.25rem; border: 1px solid #b89b68; }
  .concept--deco .hero__image { width: min(26vw, 20rem); height: 58%; position: absolute; left: 4%; top: 21%; clip-path: polygon(50% 0, 100% 18%, 100% 82%, 50% 100%, 0 82%, 0 18%); opacity: .5; }
  .concept--deco .hero__image img { filter: sepia(.65) grayscale(.5) contrast(1.15); object-position: center 55%; }

  /* 13 — sun-washed clay and cobalt, relaxed coastal composition */
  .concept--mediterranean { background: #e2a274; }
  .concept--mediterranean .concept-label { color: #4a2917; }
  .concept--mediterranean .hero { min-height: 49rem; padding: clamp(2rem, 5vw, 5rem); display: grid; background: #f7d4ae; color: #432719; }
  .concept--mediterranean .brand { color: #174f75; font: 600 .8rem/1 "Cormorant Garamond", serif; letter-spacing: .2em; }
  .concept--mediterranean .eyebrow { margin-top: 4rem; color: #805039; font-size: .65rem; letter-spacing: .15em; }
  .concept--mediterranean h3 { max-width: 9ch; margin: 1.2rem 0 1.75rem; font-family: "Noto Serif TC", serif; font-size: clamp(3.2rem, 6.5vw, 6.4rem); font-weight: 500; letter-spacing: -.045em; line-height: 1.12; }
  html[data-locale="en"] .concept--mediterranean h3 { font-family: "Cormorant Garamond", serif; line-height: .88; }
  .concept--mediterranean .intro { max-width: 32rem; color: #704733; line-height: 1.8; }
  .concept--mediterranean .cta { margin-top: 2rem; padding: .8rem 1.1rem; background: #174f75; color: #fff; }
  .concept--mediterranean .hero__image { min-height: 27rem; border-radius: 50% 50% 0 0; }
  .concept--mediterranean .hero__image img { filter: sepia(.16) saturate(.82) brightness(1.08); object-position: center 57%; }

  /* 15 — dusty rose atelier, restrained boutique framing */
  .concept--dusty-atelier { background: #b47d87; }
  .concept--dusty-atelier .concept-label { color: #3f292e; }
  .concept--dusty-atelier .hero { min-height: 50rem; padding: clamp(2rem, 5vw, 5rem); display: grid; background: #ead7d8; color: #3b292d; }
  .concept--dusty-atelier .hero::before { content: "ATELIER / 01"; position: absolute; right: 1.5rem; top: 50%; color: #82545d; font: 500 .58rem/1 "Noto Sans TC", sans-serif; letter-spacing: .2em; writing-mode: vertical-rl; }
  .concept--dusty-atelier .hero__copy { align-self: center; }
  .concept--dusty-atelier .brand { font: 600 .88rem/1 "Cormorant Garamond", serif; letter-spacing: .3em; }
  .concept--dusty-atelier .eyebrow { margin-top: clamp(4rem, 9vw, 8rem); color: #795159; font-size: .64rem; letter-spacing: .19em; }
  .concept--dusty-atelier h3 { max-width: 8.5ch; margin: 1.2rem 0 1.75rem; font-family: "Noto Serif TC", serif; font-size: clamp(3.2rem, 7vw, 6.8rem); font-weight: 400; letter-spacing: -.05em; line-height: 1.12; }
  html[data-locale="en"] .concept--dusty-atelier h3 { font-family: "Cormorant Garamond", serif; line-height: .84; }
  .concept--dusty-atelier .intro { max-width: 31rem; color: #665057; line-height: 1.8; }
  .concept--dusty-atelier .cta { margin-top: 2.25rem; padding: .75rem 1.1rem; background: #57373f; color: #fff6f5; }
  .concept--dusty-atelier .hero__image { min-height: 27rem; outline: 1px solid #a57079; outline-offset: .75rem; }
