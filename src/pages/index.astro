---
import BaseLayout from '../layouts/BaseLayout.astro';
import { locales } from '../i18n';
import { content } from '../i18n/content';
import { services, type ServiceKey } from '../i18n/services';
import { siteConfig } from '../config/site';
import { publicAsset } from '../utils/asset';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const serviceImages: Record<ServiceKey, string> = {
  waxing: publicAsset(services.waxing.image.src),
  intimateCare: publicAsset(services.intimateCare.image.src),
  areolaCare: publicAsset(services.areolaCare.image.src),
};
const homeHero = publicAsset('images/home/hero-campaign.jpg');
const productDetail = publicAsset('images/shared/skincare-products.jpg');
const serumHands = publicAsset('images/shared/serum-hands.jpg');
const closingSkin = publicAsset('images/home/closing-skin.jpg');
---
<BaseLayout>
  {locales.map((locale) => {
    const item = content[locale].home;
    return (
      <article class="home-page" data-copy={locale} lang={locale === 'en' ? 'en' : undefined}>
        <header class="home-hero page-shell" aria-labelledby={`home-title-${locale}`}>
          <div class="home-hero__copy">
            <p class="editorial-label">{item.hero.eyebrow}</p>
            <h1 id={`home-title-${locale}`}>{item.hero.title}</h1>
            <p class="home-hero__intro">{item.hero.intro}</p>
            <div class="home-hero__actions">
              <a class="primary-link" href={siteConfig.lineUrl}>{item.hero.book}<span aria-hidden="true">→</span></a>
              <a class="text-link" href={`#services-${locale}`}>{item.hero.explore}<span aria-hidden="true">↘</span></a>
            </div>
          </div>
          <figure class="home-hero__image">
            <img src={homeHero} width="640" height="640" alt={item.hero.imageAlt} loading="eager" fetchpriority="high" decoding="async" />
            <figcaption><span>MIKAMI / 01</span><span>PRIVATE · PROFESSIONAL · FOR WOMEN</span></figcaption>
          </figure>
        </header>

        <section class="manifesto page-shell" aria-labelledby={`manifesto-title-${locale}`}>
          <p class="editorial-label">{item.manifesto.eyebrow}</p>
          <div class="manifesto__statement">
            <h2 id={`manifesto-title-${locale}`}>{item.manifesto.title}</h2>
            <p>{item.manifesto.body}</p>
          </div>
        </section>

        <section class="home-services page-shell" id={`services-${locale}`} aria-labelledby={`services-title-${locale}`}>
          <div class="home-services__heading">
            <p class="editorial-label">{item.services.eyebrow}</p>
            <h2 id={`services-title-${locale}`}>{item.services.title}</h2>
          </div>
          <div class="home-services__list">
            {item.services.items.map((serviceItem) => {
              const key = serviceItem.key as ServiceKey;
              const image = services[key].image;
              return (
                <article class="home-service">
                  <figure class="home-service__image">
                    <img src={serviceImages[key]} width={image.width} height={image.height} alt={image.alt[locale]} loading="lazy" decoding="async" />
                  </figure>
                  <div class="home-service__copy">
                    <div class="home-service__meta"><span>{serviceItem.number}</span><span>{serviceItem.label}</span></div>
                    <h3>{serviceItem.title}</h3>
                    <p>{serviceItem.description}</p>
                    <a class="text-link" href={`${baseUrl}${services[key].slug}`} data-preserve-query>{item.services.link}<span aria-hidden="true">→</span></a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <figure class="visual-break">
          <img src={productDetail} width="1536" height="1024" alt={item.visual.alt} loading="lazy" decoding="async" />
          <figcaption class="page-shell">
            <span class="editorial-label">{item.visual.label}</span>
            <p>{item.visual.caption}</p>
          </figcaption>
        </figure>

        <section class="philosophy page-shell" id={`philosophy-${locale}`} aria-labelledby={`philosophy-title-${locale}`}>
          <div class="philosophy__heading">
            <p class="editorial-label">{item.philosophy.eyebrow}</p>
            <h2 id={`philosophy-title-${locale}`}>{item.philosophy.title}</h2>
            <p>{item.philosophy.intro}</p>
          </div>
          <figure class="philosophy__detail" aria-hidden="true">
            <img src={serumHands} width="1800" height="1200" alt="" loading="lazy" decoding="async" />
          </figure>
          <ol class="philosophy__values">
            {item.philosophy.values.map((value) => (
              <li><span aria-hidden="true">{value.number}</span><div><h3>{value.title}</h3><p>{value.body}</p></div></li>
            ))}
          </ol>
        </section>

        <section class="expertise page-shell" aria-labelledby={`expertise-title-${locale}`}>
          <div class="expertise__heading">
            <p class="editorial-label">{item.expertise.eyebrow}</p>
            <h2 id={`expertise-title-${locale}`}>{item.expertise.title}</h2>
            <p>{item.expertise.intro}</p>
          </div>
          <div class="expertise__list">
            {item.expertise.items.map((credential, index) => (
              <a href={siteConfig.credentials[credential.key as keyof typeof siteConfig.credentials]} target="_blank" rel="noreferrer">
                <span class="expertise__index">0{index + 1}</span>
                <span><small>{credential.label}</small><strong>{credential.title}</strong><em>{credential.body}</em></span>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>

        <section class="home-faq" id={`questions-${locale}`} aria-labelledby={`home-faq-title-${locale}`}>
          <div class="page-shell home-faq__inner">
            <div class="home-faq__heading">
              <p class="editorial-label">{item.faq.eyebrow}</p>
              <h2 id={`home-faq-title-${locale}`}>{item.faq.title}</h2>
            </div>
            <div class="home-faq__items">
              {item.faq.items.map((faq) => (
                <details><summary>{faq.question}<span aria-hidden="true"></span></summary><p>{faq.answer}</p></details>
              ))}
            </div>
          </div>
        </section>

        <section class="home-closing" aria-labelledby={`closing-title-${locale}`}>
          <figure><img src={closingSkin} width="1800" height="1200" alt={item.closing.imageAlt} loading="lazy" decoding="async" /></figure>
          <div class="home-closing__copy">
            <p class="editorial-label">{item.closing.eyebrow}</p>
            <h2 id={`closing-title-${locale}`}>{item.closing.title}</h2>
            <div class="home-closing__footer">
              <p>{item.closing.body}</p>
              <a class="primary-link" href={siteConfig.bookingUrl}>{item.closing.action}<span aria-hidden="true">→</span></a>
            </div>
          </div>
        </section>
      </article>
    );
  })}
</BaseLayout>
