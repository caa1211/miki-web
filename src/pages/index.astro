---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocalizedText from '../components/LocalizedText.astro';
import { content } from '../i18n/content';
---
<BaseLayout>
  <section class="foundation-hero page-shell" aria-labelledby="page-title">
    <div class="foundation-hero__copy">
      <p class="eyebrow">{content.zh.eyebrow}</p>
      <h1 id="page-title"><LocalizedText zh={content.zh.title} en={content.en.title} /></h1>
      <p class="intro"><LocalizedText zh={content.zh.intro} en={content.en.intro} /></p>
    </div>
    <div class="foundation-hero__visual" aria-hidden="true"><span>QUIET</span><span>CONFIDENCE</span></div>
    <p class="status-line"><span aria-hidden="true"></span><LocalizedText zh={content.zh.status} en={content.en.status} /></p>
  </section>
</BaseLayout>
