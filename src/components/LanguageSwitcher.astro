---
import { content } from '../i18n/content';
---
<nav class="language-switcher" aria-label={content.zh.languageLabel} data-language-switcher>
  <a href="?lang=zh" data-language-link="zh" lang="zh-Hant-TW" hreflang="zh-Hant-TW" aria-current="true">{content.zh.languageNames.zh}</a>
  <span aria-hidden="true">/</span>
  <a href="?lang=en" data-language-link="en" lang="en" hreflang="en">{content.en.languageNames.en}</a>
</nav>
