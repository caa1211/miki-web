---
import { content } from '../i18n/content';
import { siteConfig } from '../config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import LocalizedText from './LocalizedText.astro';
---
<footer class="site-footer">
  <div class="page-shell site-footer__inner">
    <div><p class="wordmark">{siteConfig.brandName}</p><p class="footer-description"><LocalizedText zh={content.zh.footer} en={content.en.footer} /></p></div>
    <LanguageSwitcher />
  </div>
</footer>
