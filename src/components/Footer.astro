---
import { content } from '../i18n/content';
import { siteConfig } from '../config/site';
import LocalizedText from './LocalizedText.astro';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<footer class="site-footer">
  <div class="page-shell site-footer__inner">
    <div class="footer-brand">
      <p class="wordmark">{siteConfig.brandName}</p>
      <p class="footer-description"><LocalizedText zh={content.zh.footer} en={content.en.footer} /></p>
      <address>{siteConfig.address}<br /><a href={`tel:${siteConfig.phone}`}>{siteConfig.phoneDisplay}</a></address>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href={`${baseUrl}about`} data-preserve-query data-site-link><LocalizedText zh={content.zh.nav.about} en={content.en.nav.about} /></a>
      <a href={`${baseUrl}faq`} data-preserve-query data-site-link><LocalizedText zh={content.zh.nav.faq} en={content.en.nav.faq} /></a>
      <a href={`${baseUrl}privacy`} data-preserve-query data-site-link><LocalizedText zh={content.zh.nav.privacy} en={content.en.nav.privacy} /></a>
      <a href={siteConfig.lineUrl}>LINE</a>
      <a href={`tel:${siteConfig.phone}`}>Tel</a>
    </nav>
    <nav class="footer-socials" aria-label="Social media">
      <a href={siteConfig.facebookUrl} target="_blank" rel="noreferrer" aria-label="Facebook">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M14 8.5h3V5h-3.4C10.5 5 9 6.8 9 9.7V12H6v3.5h3V22h4v-6.5h3.2l.6-3.5H13V10c0-1 .3-1.5 1-1.5Z" fill="currentColor" /></svg>
      </a>
      <a href={siteConfig.instagramUrl} target="_blank" rel="noreferrer" aria-label="Instagram">
        <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="17.4" cy="6.8" r="1" fill="currentColor" /></svg>
      </a>
      <a href={siteConfig.xUrl} target="_blank" rel="noreferrer" aria-label="X">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4.5h4.1l3.6 4.8 4.2-4.8h2.2l-5.4 6.2L20 19.5h-4.1l-4-5.4-4.8 5.4H4.9l6-6.9L5 4.5Zm3.1 1.7 8.7 11.6h1.1L9.2 6.2H8.1Z" fill="currentColor" /></svg>
      </a>
    </nav>
  </div>
</footer>
