---
import { content } from '../i18n/content';
import { siteConfig } from '../config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import LocalizedText from './LocalizedText.astro';
import { services, serviceNavigation } from '../i18n/services';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<header class="site-header" data-site-header>
  <div class="site-header__inner page-shell">
    <a class="wordmark" href={baseUrl} data-preserve-query data-site-link aria-label={`${siteConfig.brandName} home`}>
      <span class="wordmark__name">{siteConfig.brandName}</span>
      <span class="wordmark__descriptor" aria-hidden="true">WAXING · INTIMATE SKINCARE</span>
    </a>
    <nav class="primary-nav" aria-label={content.zh.navLabel} data-aria-zh={content.zh.navLabel} data-aria-en={content.en.navLabel}>
      {serviceNavigation.zh.items.map((item, index) => (
        <a href={`${baseUrl}${services[item.key].slug}`} data-preserve-query data-site-link>
          <LocalizedText zh={item.name} en={serviceNavigation.en.items[index].name} />
        </a>
      ))}
      <a href={`${baseUrl}cases`} data-preserve-query data-site-link><LocalizedText zh={content.zh.nav.cases} en={content.en.nav.cases} /></a>
      <a href={`${baseUrl}about`} data-preserve-query data-site-link><LocalizedText zh={content.zh.nav.about} en={content.en.nav.about} /></a>
    </nav>
    <div class="header-actions">
      <LanguageSwitcher />
      {siteConfig.bookingUrl ? (
        <a class="header-booking" href={siteConfig.bookingUrl}><LocalizedText zh={content.zh.nav.booking} en={content.en.nav.booking} /><span aria-hidden="true">→</span></a>
      ) : null}
      <details class="mobile-nav">
        <summary><LocalizedText zh={content.zh.nav.menu} en={content.en.nav.menu} /><span aria-hidden="true"></span></summary>
        <nav class="mobile-nav__panel" aria-label={content.zh.navLabel} data-aria-zh={content.zh.navLabel} data-aria-en={content.en.navLabel}>
          <a href={baseUrl} data-preserve-query data-site-link>
            <LocalizedText zh="首頁" en="Home" />
          </a>
          {serviceNavigation.zh.items.map((item, index) => (
            <a href={`${baseUrl}${services[item.key].slug}`} data-preserve-query data-site-link>
              <span aria-hidden="true">{services[item.key].content.zh.number}</span>
              <LocalizedText zh={item.name} en={serviceNavigation.en.items[index].name} />
            </a>
          ))}
          <a href={`${baseUrl}cases`} data-preserve-query data-site-link><LocalizedText zh={content.zh.nav.cases} en={content.en.nav.cases} /></a>
          <a href={`${baseUrl}about`} data-preserve-query data-site-link><LocalizedText zh={content.zh.nav.about} en={content.en.nav.about} /></a>
          <a href={`${baseUrl}faq`} data-preserve-query data-site-link><LocalizedText zh={content.zh.nav.faq} en={content.en.nav.faq} /></a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  let frame = 0;

  const updateHeader = () => {
    frame = 0;
    header?.toggleAttribute('data-scrolled', window.scrollY > 12);
  };

  const requestHeaderUpdate = () => {
    if (frame) return;
    frame = window.requestAnimationFrame(updateHeader);
  };

  window.addEventListener('scroll', requestHeaderUpdate, { passive: true });
  updateHeader();
</script>
